{
  "@context": {
    "@version": 1.1,
    "afp": "https://dalager.github.io/agent-federation-protocol/ns/v3.jsonld#",
    "xsd": "http://www.w3.org/2001/XMLSchema#",

    "agent": { "@id": "afp:agent", "@type": "@id" },
    "status": "afp:status",
    "since": { "@id": "afp:since", "@type": "xsd:dateTime" },
    "nonce": "afp:nonce",
    "value": "afp:value",
    "unit": "afp:unit",
    "key": "afp:key",
    "fieldType": "afp:fieldType",
    "adds": "afp:adds",
    "removes": "afp:removes",
    "element": "afp:element",
    "tag": "afp:tag",
    "tombstoneTags": "afp:tombstoneTags",
    "parties": { "@id": "afp:parties", "@type": "@id" },
    "grants": "afp:grants",
    "expiry": { "@id": "afp:expiry", "@type": "xsd:dateTime" },
    "controllers": { "@id": "afp:controllers", "@type": "@id" },

    "afp:operatedBy": { "@type": "@id" },
    "afp:actingAs": { "@type": "@id" },
    "afp:roster": { "@type": "@id" },
    "afp:policy": { "@type": "@id" },
    "afp:hub": { "@type": "@id" },
    "afp:hubKey": { "@type": "@id" },
    "afp:prevActivity": { "@type": "@id" },
    "afp:supersedes": { "@type": "@id" },
    "afp:priorAward": { "@type": "@id" },
    "afp:priorThread": { "@type": "@id" },
    "afp:synthesizer": { "@type": "@id" },
    "afp:performers": { "@type": "@id" },
    "afp:auditor": { "@type": "@id" },
    "afp:retiredBy": { "@type": "@id" },
    "afp:shadowOf": { "@type": "@id" },
    "afp:settles": { "@type": "@id" },
    "afp:task": { "@type": "@id" },
    "afp:bidder": { "@type": "@id" },
    "afp:computedBy": { "@type": "@id" },
    "afp:coordinator": { "@type": "@id" },
    "afp:members": { "@type": "@id" },
    "afp:voters": { "@type": "@id" },
    "afp:excludedBidders": { "@type": "@id" },
    "afp:excludePerformersOf": { "@type": "@id" },
    "afp:contributingResults": { "@type": "@id" },
    "afp:sourceUrl": { "@type": "@id" },

    "afp:deadline": { "@type": "xsd:dateTime" },
    "afp:acceptBy": { "@type": "xsd:dateTime" },
    "afp:fetchedAt": { "@type": "xsd:dateTime" },
    "afp:expires": { "@type": "xsd:dateTime" },
    "afp:validFrom": { "@type": "xsd:dateTime" },
    "afp:validUntil": { "@type": "xsd:dateTime" },
    "start": { "@id": "afp:start", "@type": "xsd:dateTime" },
    "end": { "@id": "afp:end", "@type": "xsd:dateTime" },
    "low": "afp:low",
    "high": "afp:high",
    "result": "afp:result",
    "afp:governanceSubject": { "@type": "@id" },
    "afp:verificationMethod": { "@type": "@id" },
    "afp:summary": { "@type": "@id" },
    "afp:hubs": { "@type": "@id" },
    "afp:since": { "@type": "xsd:dateTime" },
    "afp:observedAt": { "@type": "xsd:dateTime" },

    "afp:controllers": { "@type": "@id" },
    "afp:actor": { "@type": "@id" },
    "afp:instant": { "@type": "xsd:dateTime" }
  }
}
