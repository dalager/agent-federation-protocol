# Copy to .env — read by serve, task, show, keys, export, backup, restore and
# config:check (Node's --env-file-if-exists; a shell variable wins over this file).
# Demos and the gate never read it. Every variable is documented in
# src/configSchema.ts and README § Configuration.

# Local, single-machine operation. Plain http and loopback are only accepted
# with AFP_DEV=1; outside dev mode AFP_ORIGIN must be https.
AFP_DEV=1
AFP_ORIGIN=http://127.0.0.1:8787
AFP_PORT=8787

# Store, keys and artifacts. task/show sign with the controller key in
# AFP_DATA_DIR/keys, so this must match what serve runs with.
AFP_DATA_DIR=./data

# The agent collection serve runs (README § Defining the agent collection);
# unset, the demo's writer and reviewer.
AFP_AGENTS_FILE=./agents.json

# Who may pause, ask status, approve and hand out tasks. A controller that
# hands out tasks must be held here: an AFP_AGENTS_FILE entry with brain "none".
AFP_CONTROLLERS=http://127.0.0.1:8787/agents/operator

# Hubs this instance hosts (ADR-0037): comma-separated ids, each served as a hub
# actor at AFP_ORIGIN/hubs/<id> with its own followers collection and inbox, and
# converged by the scheduler. Unset, it hosts none. A replica set or a per-hub
# seat policy needs afp:hostedHubs in AFP_POLICY_FILE, which wins over this.
# AFP_HUBS=bridge
# Hosting a hub does not seat you on it: npm run hub -- follow <id> (ADR-0039).

# Brains: any OpenAI-compatible endpoint; the default is a local Lemonade server.
# AFP_LLM_BASE_URL=http://localhost:13305/api/v1
# AFP_LLM_MODEL=Qwen3.6-35B-A3B-NoThinking
# AFP_LLM_API_KEY=
# AFP_BRAIN=stub            # deterministic brains, no model

# Optional operations settings (ADR-0031/0032/0035).
# AFP_LOG_LEVEL=info
# AFP_POLICY_FILE=./policy.json
# AFP_KEY_PASSPHRASE_FILE=
# AFP_SIGNER_URL=
# AFP_SIGNER_ROOT_KEY_ID=
# AFP_ISSUED_KEY_LIFETIME_MS=3600000
