{
  "name": "afp-instance",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "AFP P1 reference instance - one instance, two agents, one verifiable record",
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "demo": "node --experimental-sqlite src/cli.ts demo",
    "export": "node --experimental-sqlite src/cli.ts export",
    "serve": "node --experimental-sqlite src/cli.ts serve",
    "gate": "node --experimental-sqlite --test \"test/*.test.ts\"",
    "test": "npm run gate",
    "demo:offline": "AFP_BRAIN=stub node --experimental-sqlite src/cli.ts demo",
    "demo:p2": "node --experimental-sqlite src/cli.ts p2",
    "demo:p3": "node --experimental-sqlite src/cli.ts p3",
    "demo:p3:llm": "node --experimental-sqlite src/cli.ts p3:llm",
    "demo:p4": "node --experimental-sqlite src/cli.ts p4"
  }
}
