{
  "name": "afp-instance",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "AFP P1 reference instance - one instance, two agents, one verifiable record",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "demo": "node --disable-warning=ExperimentalWarning src/cli.ts demo",
    "export": "node --disable-warning=ExperimentalWarning src/cli.ts export",
    "serve": "node --disable-warning=ExperimentalWarning src/cli.ts serve",
    "keys": "node --disable-warning=ExperimentalWarning src/cli.ts keys",
    "backup": "node --disable-warning=ExperimentalWarning src/cli.ts backup",
    "restore": "node --disable-warning=ExperimentalWarning src/cli.ts restore",
    "config:check": "node --disable-warning=ExperimentalWarning src/cli.ts config check",
    "gate": "node --disable-warning=ExperimentalWarning --test \"test/*.test.ts\"",
    "gate:demos": "node --disable-warning=ExperimentalWarning --test test/demos.test.ts",
    "test": "npm run gate",
    "demo:offline": "AFP_BRAIN=stub node --disable-warning=ExperimentalWarning src/cli.ts demo",
    "demo:p2": "node --disable-warning=ExperimentalWarning src/cli.ts p2",
    "demo:p3": "node --disable-warning=ExperimentalWarning src/cli.ts p3",
    "demo:p3:llm": "node --disable-warning=ExperimentalWarning src/cli.ts p3:llm",
    "demo:p4": "node --disable-warning=ExperimentalWarning src/cli.ts p4",
    "demo:p5": "node --disable-warning=ExperimentalWarning src/cli.ts p5",
    "demo:p5:llm": "node --disable-warning=ExperimentalWarning src/cli.ts p5:llm",
    "demo:p6": "node --disable-warning=ExperimentalWarning src/cli.ts p6",
    "demo:p7": "node --disable-warning=ExperimentalWarning src/cli.ts p7",
    "demo:p7:llm": "node --disable-warning=ExperimentalWarning src/cli.ts p7:llm",
    "demo:p8": "node --disable-warning=ExperimentalWarning src/cli.ts p8",
    "demo:p8:llm": "node --disable-warning=ExperimentalWarning src/cli.ts p8:llm",
    "demo:p6:llm": "node --disable-warning=ExperimentalWarning src/cli.ts p6:llm"
  }
}
